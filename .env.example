# Copie para ".env" (não commite o .env). Todos os valores abaixo são opcionais no dev.
DB_PASSWORD=produtos_dev

# Serviço de identidade (JWKS). Ajuste para o endereço real do grupo de identidade.
JWT_ISSUER=http://identity.local
JWT_JWKS_URI=http://identity:8081/api/identity/.well-known/jwks.json
JWT_AUDIENCE=produtos

# Origens do front liberadas por CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200
