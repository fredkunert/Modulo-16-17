# Copie para .env (não versionado) e ajuste. Usado pelo compose.yaml.

# Banco do container
POSTGRES_PASSWORD=postgres
DB_USER=own_produtos
DB_PASSWORD=produtos
DB_HOST_PORT=5434

# API (perfil "app" do compose) — dados do provedor de autenticação da equipe
JWT_ISSUER=https://auth.exemplo.com
JWT_JWKS_URI=https://auth.exemplo.com/.well-known/jwks.json
JWT_AUDIENCE=produtos
JWT_PERMISSIONS_CLAIM=permissions
API_HOST_PORT=8083
